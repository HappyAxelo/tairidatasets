# ---- Application ----
PROJECT_NAME=TAIRI DataHub
ENVIRONMENT=development
DEBUG=true

# ---- Security (CHANGE THESE IN PRODUCTION) ----
SECRET_KEY=please-generate-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_TIMEOUT_MINUTES=60

# ---- Database ----
POSTGRES_USER=tairi
POSTGRES_PASSWORD=tairi_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=tairi_datahub
# Optional full override; leave blank to build from the parts above.
# DATABASE_URL=postgresql+psycopg://tairi:tairi_password@db:5432/tairi_datahub

# ---- CORS (comma-separated) ----
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Storage ----
# local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=storage
MAX_UPLOAD_SIZE_MB=5120
# S3 / MinIO (only used when STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=tairi-datasets
S3_REGION=us-east-1

# ---- Email (leave SMTP_HOST blank to log emails instead of sending) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@tairi.ur.ac.rw
SMTP_TLS=true
FRONTEND_URL=http://localhost:3000

# ---- Bootstrap super administrators (exactly 3) ----
SUPERADMIN_EMAILS=admin1@tairi.ur.ac.rw,admin2@tairi.ur.ac.rw,admin3@tairi.ur.ac.rw
SUPERADMIN_DEFAULT_PASSWORD=ChangeMe#2026
