# Normalise line endings so Linux/Docker builds are never broken by a
# Windows checkout. Shell scripts and container files MUST stay LF.
* text=auto eol=lf

*.sh          text eol=lf
Dockerfile    text eol=lf
*.dockerfile  text eol=lf
entrypoint.sh text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf

# Binary assets — never touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
