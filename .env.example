# ==========================================================================
# TAIRI DataHub — root environment file for docker compose.
# Copy to .env and change every secret before deploying.
# ==========================================================================

# --- Database ---
POSTGRES_USER=tairi
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=tairi_datahub

# --- Security ---
# Generate with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_long_random_secret

# --- URLs (set to your server's public URL, e.g. http://datahub.ur.ac.rw) ---
FRONTEND_URL=http://localhost
BACKEND_CORS_ORIGINS=http://localhost

# --- Storage: local | s3 ---
STORAGE_BACKEND=local

# --- Super administrators (exactly 3) ---
SUPERADMIN_EMAILS=admin1@tairi.ur.ac.rw,admin2@tairi.ur.ac.rw,admin3@tairi.ur.ac.rw
SUPERADMIN_DEFAULT_PASSWORD=ChangeMe#2026

# --- Email (leave SMTP_HOST empty to log emails to the backend console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
